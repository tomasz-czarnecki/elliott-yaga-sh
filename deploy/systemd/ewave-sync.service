[Unit]
Description=ewave: fetch new BTC 1m candles (Bitstamp, Binance, Bybit), close finished days, update bars

[Service]
Type=oneshot
WorkingDirectory=/home/tomas/000_Dev/elliot-yaga-sh
Environment=EWAVE_DATA=/home/tomas/000_Dev/elliot-yaga-sh/data TZ=UTC PYTHONUNBUFFERED=1
ExecStart=/home/tomas/000_Dev/elliot-yaga-sh/.venv/bin/ewave-data sync
# a hung run must not block every later timer firing
TimeoutStartSec=15min
Nice=10
